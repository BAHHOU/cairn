# Database (PostgreSQL 17)
DATABASE_URL=postgresql://cairn:cairn@localhost:5432/cairn

# App
APP_URL=http://localhost:3000
DEMO_MODE=true

# Repository import (superadmin). Real clone of one branch from GitHub / GitLab.
# Egress allowlist: the ONLY Git hosts Cairn may contact. Bare entries are HTTPS.
# Add your self-hosted GitLab / GitHub Enterprise here. Plain HTTP only for local dev: http://127.0.0.1:4010
GIT_HOSTS=github.com,gitlab.com
# Key encrypting provider tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAIRN_SECRET_KEY=
GIT_API_TIMEOUT_MS=15000
GIT_CLONE_TIMEOUT_MS=300000
# Behind a corporate proxy: make Node's fetch honour HTTP(S)_PROXY / NO_PROXY (git already does).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.example:8080
# Corporate TLS inspection: CA bundle for Node and for git.
# NODE_EXTRA_CA_CERTS=C:\certs\corp-ca.pem
# GIT_SSL_CAINFO=C:\certs\corp-ca.pem

# Auth (OIDC: Keycloak, Entra ID, ...)
AUTH_SECRET=change-me-with-32-random-bytes
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC group names mapped to roles
OIDC_GROUP_SUPERADMIN=cairn-superadmin
OIDC_GROUP_ADMIN=cairn-admin
OIDC_GROUP_MANAGER=cairn-manager
OIDC_GROUP_DEV=cairn-dev

# Internal CACIB LLM gateway (OpenAI-compatible). Disabled by default.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# Optional custom auth header, e.g. "X-Gateway-Token: abc"
LLM_AUTH_HEADER=
LLM_MODEL_DEFAULT=
LLM_MODEL_SMALL=
LLM_MODEL_EMBED=
LLM_TIMEOUT_MS=60000
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1500
# Corporate certificate authority bundle for the gateway
NODE_EXTRA_CA_CERTS=

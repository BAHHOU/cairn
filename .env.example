# Database (PostgreSQL 17)
DATABASE_URL=postgresql://cairn:cairn@localhost:5432/cairn

# App
APP_URL=http://localhost:3000
DEMO_MODE=true

# Auth (OIDC: Keycloak, Entra ID, ...)
AUTH_SECRET=change-me-with-32-random-bytes
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC group names mapped to roles
OIDC_GROUP_SUPERADMIN=cairn-superadmin
OIDC_GROUP_ADMIN=cairn-admin
OIDC_GROUP_MANAGER=cairn-manager
OIDC_GROUP_DEV=cairn-dev

# Internal CACIB LLM gateway (OpenAI-compatible). Disabled by default.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# Optional custom auth header, e.g. "X-Gateway-Token: abc"
LLM_AUTH_HEADER=
LLM_MODEL_DEFAULT=
LLM_MODEL_SMALL=
LLM_MODEL_EMBED=
LLM_TIMEOUT_MS=60000
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1500
# Corporate certificate authority bundle for the gateway
NODE_EXTRA_CA_CERTS=
